{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "TracePcap chart values",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "registry": {"type": "string"},
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "size": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {"type": "string"},
        "imagePullSecrets": {"type": "array"},
        "storageClass": {"type": "string"}
      }
    },
    "timezone": {"type": "string"},
    "clusterDomain": {"type": "string"},
    "utilityImage": {"$ref": "#/definitions/image"},
    "backend": {
      "type": "object",
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "memoryMB": {"type": "integer", "minimum": 1024},
        "jvmHeapPercent": {"type": "integer", "minimum": 10, "maximum": 90},
        "springProfile": {"type": "string"},
        "corsAllowedOrigins": {"type": "string"},
        "llm": {
          "type": "object",
          "properties": {
            "baseUrl": {"type": "string", "pattern": "^$|^https?://"},
            "model": {"type": "string"},
            "apiKey": {"type": "string"},
            "existingSecret": {"type": "string"},
            "existingSecretKey": {"type": "string", "minLength": 1},
            "temperature": {"type": ["string", "number"]},
            "maxTokens": {"type": ["string", "integer"]},
            "contextLength": {"type": ["string", "integer"]},
            "timeout": {"type": ["string", "integer"]},
            "toolCalling": {"enum": ["auto", "on", "off"]}
          }
        },
        "geoForceOffline": {"type": "boolean"},
        "retention": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "fileHours": {"type": "integer", "minimum": 0},
            "monitorFileHours": {"type": "integer", "minimum": 0},
            "packetHours": {"type": "integer", "minimum": 0}
          }
        },
        "suricata": {
          "type": "object",
          "properties": {"enabled": {"type": "boolean"}, "warmEngine": {"type": "boolean"}}
        },
        "maxUploadPackets": {"type": "integer", "minimum": 0},
        "systemSettingsEditable": {"type": "boolean"},
        "extraEnv": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "extraEnvRaw": {"type": "array"}
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "service": {
          "type": "object",
          "properties": {
            "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer"}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "hosts": {"type": "array"},
        "tls": {"type": "array"}
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "persistence": {"$ref": "#/definitions/persistence"}
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer"},
        "database": {"type": "string"},
        "username": {"type": "string"}
      }
    },
    "minio": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},
        "persistence": {"$ref": "#/definitions/persistence"}
      }
    },
    "externalS3": {
      "type": "object",
      "properties": {
        "endpoint": {"type": "string", "pattern": "^$|^https?://"},
        "bucket": {"type": "string"}
      }
    },
    "networkPolicy": {"type": "object", "properties": {"enabled": {"type": "boolean"}}}
  }
}
